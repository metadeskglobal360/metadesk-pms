# Copy this file to .env.local for local development.
# In production, add these values in your hosting provider's environment settings.
# Never commit real secrets.

# MongoDB Atlas connection string, for example:
# mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/metadesk_pms?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=

# Use mongo for real storage. Only set demo for local in-memory experiments.
METADESK_STORE=mongo

# Local-only sample seed. Ignored in production.
METADESK_SEED_DEMO=false

# Auth.js / NextAuth. Use the same strong random value for both for compatibility.
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-domain.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email OTP verification.
# Recommended for testing: use Gmail SMTP with a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Optional fallback: Resend API. Resend requires a verified domain for sending to real users.
RESEND_API_KEY=

NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_NAME=Metadesk PMS
